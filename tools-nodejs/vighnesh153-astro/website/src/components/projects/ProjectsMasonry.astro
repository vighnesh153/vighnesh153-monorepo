---
import { classes } from "@/utils/classes.ts";
import { allProjects } from "@/utils/content/projects.ts";
import { FolderIcon } from "@/icons/FolderIcon.tsx";
import ProjectIconLink from "./ProjectIconLink.astro";
import ProjectTag from "./ProjectTag.astro";
import { Link } from "../Link.tsx";
---

<style lang="scss">
  @use "@/styles/variables.scss" as *;

  ul.projects-masonry {
    margin-block-start: $spacing * 8;

    display: grid;
    justify-items: center;
    gap: $spacing * 12;

    grid-template-columns: repeat(1, minmax(0, 1fr));

    @media (min-width: $breakpoint-lg) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (min-width: $breakpoint-xl) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    grid-template-rows: masonry;

    @media (grid-template-rows: masonry) {
      align-items: start;
    }
  }

  li.project-item {
    max-width: $container-lg;
    padding: $spacing * 6;

    display: flex;
    flex-direction: column;

    border-radius: $radius-lg;
    background: $bg-light;

    --_shadow-color: #{$bg-dark};
    box-shadow: $shadow-md;

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      .folder-icon {
        fill: $color-accent;
      }

      ul {
        display: flex;
        gap: $spacing * 4;

        fill: $color-bright;

        li {
          &:focus-within,
          &:hover {
            fill: $color-accent;
          }
        }
      }
    }

    h3 {
      margin-block-start: $spacing * 5;

      font-size: $text-size-xl;
      line-height: $line-height-xl;

      @media (min-width: $breakpoint-md) {
        font-size: $text-size-2xl;
        line-height: $line-height-2xl;
      }
    }

    .project-desc {
      margin-block-start: $spacing * 4;

      flex-grow: 1;

      color: $color;
      font-size: $text-size-base;
      line-height: $line-height-base;
    }

    .project-tags {
      margin-block-start: $spacing * 6;

      display: flex;
      flex-wrap: wrap;
      gap: $spacing * 2;
    }
  }
</style>

<ul class="projects-masonry">
  {
    allProjects.map(({ title, description, tags, links }) => (
      <li class="project-item">
        <div class="header">
          <FolderIcon className="folder-icon" role="img" height="2rem" />

          <ul>
            <li>
              <ProjectIconLink href={links.github.href} title="source code">
                <links.github.Icon
                  role="img"
                  width="1.25rem"
                  height="1.25rem"
                />
              </ProjectIconLink>
            </li>
            <li>
              <ProjectIconLink href={links.demo.href} title="demo">
                <links.demo.Icon role="img" width="1.25rem" height="1.25rem" />
              </ProjectIconLink>
            </li>
          </ul>
        </div>
        <h3>
          <Link href={links.demo.href}>{title}</Link>
        </h3>
        <p class="project-desc">{description}</p>
        <ul class="project-tags">
          {tags.map((tag) => (
            <ProjectTag>{tag}</ProjectTag>
          ))}
        </ul>
      </li>
    ))
  }
</ul>
