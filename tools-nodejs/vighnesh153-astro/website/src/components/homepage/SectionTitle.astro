---
export interface Props {
  count: string;
  title: string;
}

const { count, title } = Astro.props;
---

<style lang="scss">
  @use "@/styles/variables.scss" as *;

  h2 {
    display: flex;
    align-items: center;

    font-size: $text-size-xl;
    line-height: $text-size-xl--line-height;

    @media (min-width: $breakpoint-sm) {
      font-size: $text-size-2xl;
      line-height: $text-size-2xl--line-height;
    }

    @media (min-width: $breakpoint-md) {
      font-size: $text-size-3xl;
      line-height: $text-size-3xl--line-height;
    }

    @media (min-width: $breakpoint-lg) {
      font-size: $text-size-4xl;
      line-height: $text-size-4xl--line-height;
    }

    font-weight: $font-weight-bold;
    whitespace: nowrap;

    &::after {
      content: "";

      margin-inline-start: $spacing * 4;
      width: 100%;
      max-width: $container-xs;
      height: 1px;

      display: inline-block;
      background: $color-dull;
    }

    span {
      color: $color-accent;
    }
  }
</style>

<h2>
  <span>{count}.</span>&nbsp;{title}
</h2>
