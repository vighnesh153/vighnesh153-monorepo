---
import { CircleChevronRightIcon } from "@/icons/CircleChevronRightIcon.tsx";

interface Props {
  className?: string;
}
---

<style lang="scss">
  @use "@/styles/variables.scss" as *;

  li {
    position: relative;
    margin-block-end: $spacing * 2;

    display: flex;
    align-items: flex-start;
    gap: $spacing * 4;

    @media (min-width: $breakpoint-md) {
      gap: $spacing * 6;
    }

    span {
      fill: $color-accent;
      margin-block-start: 0.25em;
    }
  }
</style>

<li>
  <span>
    <CircleChevronRightIcon aria-hidden="true" />
  </span>
  <slot />
</li>
