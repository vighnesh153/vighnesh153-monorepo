---
import { classes } from "@/utils/classes.ts";
import { hashTags } from "@/utils/content/links.ts";
import { currentTechnologies } from "@/utils/content/currentTechnologies.ts";
import { companyUrls } from "@/utils/content/companyUrls.ts";
import SectionTitle from "./SectionTitle.astro";
import { Link } from "../Link.tsx";
import SectionListItem from "./SectionListItem.astro";
---

<style lang="scss">
  @use "@/styles/variables.scss" as *;

  section {
    max-width: $width-prose;
    margin-inline: auto;
    margin-block-start: $spacing * 20;
  }

  section > div {
    margin-block-start: $spacing * 6;

    font-weight: $font-weight-light;
    color: $color;

    font-size: $text-size-base;
    line-height: $text-size-base--line-height;

    @media (min-width: $breakpoint-sm) {
      font-size: $text-size-lg;
      line-height: $text-size-lg--line-height;
    }

    @media (min-width: $breakpoint-xl) {
      font-size: $text-size-xl;
      line-height: $text-size-xl--line-height;
    }
  }

  ul {
    margin-block-start: $spacing * 4;
  }
</style>

<section id={hashTags.homePage.aboutMe}>
  <SectionTitle count="01" title="About me" />
  <div>
    <p>
      Hello. My name is Vighnesh and I enjoy creating projects involving
      graphics manipulations, cli-tools, libraries and also developer tools. My
      interest in software development started a few years back when I first
      learnt about Javascript. Since then, I have been building teeny-tiny
      projects for fun. I am also fascinated by compilers and I am on a journey
      to master the art of building a compiler
      <br />
      <br />
      Fast-forward to today, and I have had the privilege to work for{" "}
      <Link href={companyUrls.google} target="_blank">Google</Link>
      ,{" "}
      <Link href={companyUrls.amazon} target="_blank">Amazon</Link>
      ,{" "}
      <Link href={companyUrls.smarterCodes} target="_blank">an AI startup</Link
      >{" "}
      and{" "}
      <Link href={companyUrls.tavisca} target="_blank"
        >a loyalty rewards company</Link
      >
      <br />
      <br />
      My Main focus these days is building next-gen developer tools for GoogleTV at{
        " "
      }
      <Link href={companyUrls.google} target="_blank">Google</Link>
      <br />
      <br />
      Here are a few technologies I have been working with recently:
      <br />
    </p>
    <ul class="mt-4">
      {
        currentTechnologies.map((technology) => (
          <SectionListItem>
            <Link href={technology.link}>{technology.text}</Link>
          </SectionListItem>
        ))
      }
    </ul>
  </div>
</section>
