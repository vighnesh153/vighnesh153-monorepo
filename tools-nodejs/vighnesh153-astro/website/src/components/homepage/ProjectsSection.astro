---
import { hashTags } from "@/utils/content/links.ts";
import { classes } from "@/utils/classes.ts";
import ProjectsMasonry from "@/components/projects/ProjectsMasonry.astro";
import SectionTitle from "./SectionTitle.astro";
---

<style lang="scss">
  @use "@/styles/variables.scss" as *;

  section {
    margin-inline: auto;
    margin-block: $spacing * 40;

    & > div {
      margin-inline: auto;
      max-width: $width-prose;
    }
  }
</style>

<section id={hashTags.homePage.projects}>
  <div>
    <SectionTitle count="03" title="Projects" />
  </div>
  <ProjectsMasonry />
</section>
