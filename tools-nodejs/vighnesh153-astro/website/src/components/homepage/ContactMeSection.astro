---
import { hashTags } from "@/utils/content/links.ts";
import { myPersonalizedEmail } from "@/utils/content/emails.ts";
import { Link } from "../Link.tsx";
---

<style lang="scss">
  @use "@/styles/variables.scss" as *;

  section {
    margin-inline: auto;
    margin-block: $spacing * 40;
    max-width: $width-prose;

    text-align: center;
  }

  .section-header {
    color: $color-accent;
    font-size: $text-size-base;
    line-height: $line-height-base;
  }

  h2 {
    margin-block-start: $spacing * 2;

    font-size: $text-size-2xl;
    line-height: $line-height-2xl;

    @media (min-width: $breakpoint-md) {
      font-size: $text-size-3xl;
      line-height: $line-height-3xl;
    }

    @media (min-width: $breakpoint-lg) {
      font-size: $text-size-4xl;
      line-height: $line-height-4xl;
    }
  }

  .section-body {
    margin-block-start: $spacing * 2;
    margin-inline: auto;
    max-width: $container-xl;

    color: $color;
    font-weight: $font-weight-light;

    font-size: $text-size-base;
    line-height: $line-height-base;

    @media (min-width: $breakpoint-sm) {
      font-size: $text-size-xl;
      line-height: $line-height-xl;
    }
  }

  a {
    margin-block-start: $spacing * 4;

    &:focus-visible {
      --_outline-color: #{$color-primary};
    }
  }
</style>

<section id={hashTags.homePage.contactMe}>
  <p class="section-header">04. What's next?</p>
  <h2>Get In Touch</h2>
  <p class="section-body">
    My inbox is always open, whether you have a question or just to say hi. I
    will try my best to get back to you.
  </p>
  <Link
    className="no-base-style"
    linkType="primary-btn"
    href={`mailto:${myPersonalizedEmail}`}
  >
    Say Hello
  </Link>
</section>
