{
  "name": "website",
  "type": "module",
  "scripts": {
    "dev:functions": "deno watch -A --unstable-bundle ./src/firebase/functions/bundler.ts",
    "dev:emulators": "npx firebase emulators:start --project demo-vighnesh153-app",
    "dev-bak": "astro dev",
    "dev": "deno task dev:*",
    "build:functions": "deno run -A --unstable-bundle ./src/firebase/functions/bundler.ts",
    "build:ui": "astro build",
    "build": "deno task build:*",
    "deploy:functions": "deno task build:functions && firebase deploy --only functions",
    "deploy:ui": "deno task build:ui && firebase deploy --only hosting",
    "deploy": "deno task build && firebase deploy"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.0.3",
    "firebase": "^12.15.0",
    "firebase-functions": "^7.2.5",
    "firebase-tools": "^15.22.4",
    "sass": "^1.101.0",
    "svelte": "^5.56.4"
  }
}
